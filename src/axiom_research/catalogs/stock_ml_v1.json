        "unknown_group": "reject",
        "missing": "skip",
        "ddof": 0,
        "epsilon": 1e-12,
        "constant": "missing",
        "clip": null,
        "excluded": "missing"
      },
      "missing_policy": "preserve; require complete finite positive close window; never fill zero",
      "semantic_version": "1.0.0",
      "core_nodes": [
        {
          "name": "mom010_window_min",
          "op": "rolling",
          "version": "1",
          "inputs": [
            "_positive_close"
          ],
          "params": {
            "window": 2,
            "min_periods": 2,
            "inclusive_current": true,
